<Window x:Class="Brona.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{DynamicResource S.Picker.Title}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000" Opacity="0"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <!-- 外观默认值，启动时会按用户设置覆盖 -->
    <Window.Resources>
        <Thickness x:Key="TileMargin">0,0,30,0</Thickness>
        <sys:Double x:Key="TileIconSize">24</sys:Double>
        <sys:Double x:Key="TileWidth">76</sys:Double>
        <sys:Double x:Key="TileHeight">64</sys:Double>
        <Visibility x:Key="PrivateChipVisibility">Visible</Visibility>

        <!-- 「记住此网站的选择」：不显眼的小复选项，不抢键盘焦点 -->
        <Style x:Key="RememberChip" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Box" FontFamily="{StaticResource IconFont}" Text="&#xE739;" FontSize="12"
                                       Margin="0,1,6,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Text" Value="&#xE73A;" />
                                <Setter TargetName="Box" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外边距给阴影留出空间 -->
    <Grid x:Name="CardHost" Margin="16" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="0.94" ScaleY="0.94" />
                <TranslateTransform x:Name="CardShift" Y="8" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- 阴影单独一层，避免投影效果让文字发虚 -->
        <Border CornerRadius="12" Background="{DynamicResource CardBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.2"
                                  Color="#000000" RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <Border x:Name="Card" CornerRadius="12" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <StackPanel Margin="16,8,8,14">

                <!-- 顶部一行：链接 + 无痕 / 复制 / 设置 / 关闭，可拖动 -->
                <DockPanel MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <!-- 二维码：用小图形绘制图标；不抢焦点，保持磁贴的键盘选中状态 -->
                        <Button x:Name="QrButton" Style="{StaticResource IconButton}" Width="24" Height="24" Focusable="False"
                                ToolTip="{DynamicResource S.Qr.Tip}" Click="Qr_Click">
                            <Path Width="11" Height="11" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="F0 M0,0 H5 V5 H0 Z M1.2,1.2 V3.8 H3.8 V1.2 Z M2,2 H3 V3 H2 Z
                                        M7,0 H12 V5 H7 Z M8.2,1.2 V3.8 H10.8 V1.2 Z M9,2 H10 V3 H9 Z
                                        M0,7 H5 V12 H0 Z M1.2,8.2 V10.8 H3.8 V8.2 Z M2,9 H3 V10 H2 Z
                                        M7,7 H9 V9 H7 Z M10,7 H12 V8.5 H10 Z M10,10 H12 V12 H10 Z M7.5,10.5 H9 V12 H7.5 Z" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="11"
                                ToolTip="{DynamicResource S.Picker.CopyTip}" Click="Copy_Click">
                            <TextBlock x:Name="CopyIcon" Text="&#xE8C8;" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="11"
                                Content="&#xE713;" ToolTip="{DynamicResource S.Picker.SettingsTip}" Click="Settings_Click" />
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10"
                                Content="&#xE8BB;" ToolTip="{DynamicResource S.Picker.CancelTip}" Click="Cancel_Click" />
                    </StackPanel>
                    <TextBlock x:Name="SchemeIcon" FontFamily="{StaticResource IconFont}" FontSize="11"
                               VerticalAlignment="Center" Margin="2,1,7,0" />
                    <!-- 链接安全检查有警告时显示，悬停查看原因；不阻止打开 -->
                    <TextBlock x:Name="WarnIcon" Visibility="Collapsed" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0" Cursor="Help"
                               Foreground="{DynamicResource WarningBrush}" />
                    <!-- 网址始终从左到右显示，不随界面语言镜像 -->
                    <TextBlock x:Name="UrlText" TextTrimming="CharacterEllipsis" MaxWidth="360" FlowDirection="LeftToRight"
                               HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12">
                        <Run x:Name="HostRun" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><Run x:Name="PathRun" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </TextBlock>
                </DockPanel>

                <!-- 一排：浏览器磁贴 | 取消 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,8,0">
                    <ItemsControl x:Name="BrowserList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle"
                                            KeyboardNavigation.TabNavigation="Cycle" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 每个浏览器：上面是普通打开的磁贴，下面是「无痕」小按钮 -->
                                <StackPanel Margin="{DynamicResource TileMargin}">
                                <Button Style="{StaticResource BrowserTile}" Tag="{Binding}" ToolTip="{Binding Name}"
                                        Margin="0" Width="{DynamicResource TileWidth}"
                                        Height="{DynamicResource TileHeight}"
                                        Click="Tile_Click" MouseEnter="Tile_MouseEnter"
                                        MouseRightButtonUp="Tile_RightClick">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="{DynamicResource TileIconSize}"
                                                   Height="{DynamicResource TileIconSize}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding ShortName}" Margin="4,6,4,0" FontSize="11"
                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <!-- 数字快捷键角标 -->
                                        <TextBlock Text="{Binding Shortcut}" FontSize="9" FontWeight="SemiBold" Margin="6,4"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                </Button>
                                <!-- 无痕打开；设置中可整体隐藏；不支持时隐藏但保留位置，保持对齐 -->
                                <Border Visibility="{DynamicResource PrivateChipVisibility}">
                                <Button x:Name="PrivateChip" Style="{StaticResource GhostButton}" Tag="{Binding}"
                                        Width="{DynamicResource TileWidth}" MinHeight="0" Height="22" Margin="0,6,0,0"
                                        Padding="0" FontSize="11" Focusable="False"
                                        ToolTip="{DynamicResource S.Picker.PrivateTip}" Click="PrivateChip_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE727;" FontSize="10.5"
                                                   VerticalAlignment="Center" Margin="0,1,5,0" />
                                        <TextBlock Text="{DynamicResource S.Picker.Private}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding SupportsPrivate}" Value="False">
                                        <Setter TargetName="PrivateChip" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 没有浏览器时的提示 -->
                    <Border x:Name="EmptyPanel" Visibility="Collapsed" Height="{DynamicResource TileHeight}"
                            Padding="14,0" Margin="0,0,10,0"
                            CornerRadius="10" Background="{DynamicResource TileBrush}">
                        <TextBlock Text="{DynamicResource S.Picker.Empty}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>

                    <!-- 分隔线 + 取消 -->
                    <Border Width="1" Height="40" Margin="0,0,24,0" VerticalAlignment="Center"
                            Background="{DynamicResource DividerBrush}" />
                    <!-- 取消按钮占满整行高度（磁贴 + 无痕按钮） -->
                    <Button Style="{StaticResource GhostButton}" Width="64" Padding="0"
                            ToolTip="{DynamicResource S.Picker.CancelTip}" Click="Cancel_Click">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="16"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Common.Cancel}" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 链接二维码：点击顶部二维码按钮展开，供手机扫码；Esc 先收起它 -->
                <StackPanel x:Name="QrPanel" Visibility="Collapsed" Margin="0,12,8,0" HorizontalAlignment="Center">
                    <Border Background="White" CornerRadius="8" Padding="0" HorizontalAlignment="Center"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Height="170" Width="170">
                        <Image x:Name="QrImage" Width="168" Height="168" RenderOptions.EdgeMode="Aliased" />
                    </Border>
                    <TextBlock x:Name="QrHint" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <!-- 记住此网站的选择：勾选后，下一次点浏览器时添加一条域名规则 -->
                <CheckBox x:Name="RememberBox" Style="{StaticResource RememberChip}" Visibility="Collapsed"
                          Margin="0,12,0,0" HorizontalAlignment="Left" Content="{DynamicResource S.Rules.Remember}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
