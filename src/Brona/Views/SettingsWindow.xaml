<Window x:Class="Brona.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brona" Width="760" Height="500" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CardBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <!-- 自定义标题栏：保留系统的拖动、贴靠、缩放和阴影 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 侧边栏导航项 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" />
                            </Grid.RenderTransform>
                            <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource HoverOverlayBrush}" Opacity="0" />
                            <Border x:Name="Selected" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" Opacity="0" />
                            <!-- 选中时左侧的强调色指示条 -->
                            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="IndicatorScale" ScaleY="0" />
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,1,12,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏按钮（最小化 / 最大化 / 关闭） -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Hover" Background="{DynamicResource HoverOverlayBrush}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮：悬停为红色 -->
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 页面标题 -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- 区块小标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,22,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>

        <!-- 简约行：无底色，仅底部细线分隔 -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="2,12" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧边栏：浅灰底区分 ================= -->
        <Border Background="{DynamicResource WindowBrush}" />
        <DockPanel Margin="14,0,12,14">
            <!-- 品牌（位于标题栏区域，可拖动窗口） -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Margin="4,6,0,18">
                <Image Source="{StaticResource LogoImage}" Width="26" Height="26" VerticalAlignment="Center" />
                <TextBlock Text="Brona" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" FontSize="11" Margin="6,0,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}" />

            <StackPanel>
                <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Content="{DynamicResource S.Nav.Home}"
                             Tag="&#xE80F;" IsChecked="True" Checked="Nav_Checked" />
                <RadioButton x:Name="NavBrowsers" Style="{StaticResource NavItem}" Content="{DynamicResource S.Nav.Browsers}"
                             Tag="&#xE774;" Checked="Nav_Checked" />
                <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Content="{DynamicResource S.Nav.Appearance}"
                             Tag="&#xE790;" Checked="Nav_Checked" />
                <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="{DynamicResource S.Nav.About}"
                             Tag="&#xE946;" Checked="Nav_Checked" />
            </StackPanel>
        </DockPanel>

        <!-- ================= 右侧 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="{DynamicResource S.Window.Minimize}" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="{DynamicResource S.Window.Maximize}" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="{DynamicResource S.Window.Close}" Click="Close_Click" />
            </StackPanel>

            <Grid x:Name="PageHost" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PageShift" />
                </Grid.RenderTransform>

                <!-- ========== 页面：概览 ========== -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32,16,32,28">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Home.Title}" />

                        <!-- 状态：小圆点 + 一句话 + 一个按钮 -->
                        <DockPanel Margin="0,22,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Top" Margin="2,8,12,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="OpenDefaultsButton" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                        Content="{DynamicResource S.Home.SystemSettings}" Click="OpenDefaults_Click" />
                                <Button x:Name="RegisterButton" Style="{StaticResource PrimaryButton}" Click="Register_Click" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTitle" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="StatusDesc" Style="{StaticResource CardHint}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,24,0,0" />

                        <!-- 试一试 -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Home.TryIt}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                    Click="Test_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="11"
                                               Margin="0,1,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Home.Preview}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="TestUrlBox" Style="{StaticResource InputBox}" Text="https://github.com"
                                     FlowDirection="LeftToRight" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 页面：浏览器 ========== -->
                <ScrollViewer x:Name="PageBrowsers" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="32,16,32,28">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                    Click="AddManual_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="11"
                                               Margin="0,1,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Browsers.AddManual}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Browsers.Title}" />
                                <TextBlock Style="{StaticResource CardHint}" Text="{DynamicResource S.Browsers.Hint}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Browsers.Mine}" />
                        <!-- 按住任意一行拖动即可排序 -->
                        <ItemsControl x:Name="MyList" Background="Transparent"
                                      PreviewMouseLeftButtonDown="MyList_MouseDown" PreviewMouseMove="MyList_MouseMove"
                                      PreviewMouseLeftButtonUp="MyList_MouseUp" LostMouseCapture="MyList_LostCapture">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 卡片式行：悬停时浅色高亮，左侧出现六点拖动手柄 -->
                                    <Border x:Name="Row" CornerRadius="10" BorderThickness="1" Padding="0,10,8,10" Margin="0,0,0,8"
                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <DockPanel>
                                            <!-- 拖动手柄：只在悬停时显示，鼠标变成小手 -->
                                            <Border x:Name="Grip" Width="34" Background="Transparent" Cursor="Hand"
                                                    ToolTip="{DynamicResource S.Browsers.DragTip}">
                                                <Path x:Name="GripDots" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Data="M1.6,0 A1.6,1.6 0 1 1 1.6,3.2 A1.6,1.6 0 1 1 1.6,0 Z
                                                            M7.6,0 A1.6,1.6 0 1 1 7.6,3.2 A1.6,1.6 0 1 1 7.6,0 Z
                                                            M1.6,5.4 A1.6,1.6 0 1 1 1.6,8.6 A1.6,1.6 0 1 1 1.6,5.4 Z
                                                            M7.6,5.4 A1.6,1.6 0 1 1 7.6,8.6 A1.6,1.6 0 1 1 7.6,5.4 Z
                                                            M1.6,10.8 A1.6,1.6 0 1 1 1.6,14 A1.6,1.6 0 1 1 1.6,10.8 Z
                                                            M7.6,10.8 A1.6,1.6 0 1 1 7.6,14 A1.6,1.6 0 1 1 7.6,10.8 Z" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                    VerticalAlignment="Center" Cursor="Hand" ToolTip="{DynamicResource S.Browsers.Remove}"
                                                    Tag="{Binding}" Click="Remove_Click" />
                                            <!-- 图标放在带细边框的圆角方块里 -->
                                            <Border Width="40" Height="40" CornerRadius="9" BorderThickness="1" Margin="0,0,14,0"
                                                    VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}">
                                                <Image Source="{Binding Icon}" Width="24" Height="24"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <!-- 数字快捷键标签 -->
                                                    <Border CornerRadius="9" BorderThickness="1" Padding="7,0,7,1" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" BorderBrush="{DynamicResource CardBorderBrush}"
                                                            ToolTip="{DynamicResource S.Browsers.Hint}">
                                                        <TextBlock Text="{Binding Shortcut}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <!-- 支持无痕的标签 -->
                                                    <Border x:Name="PrivateBadge" CornerRadius="9" Padding="7,0,7,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE727;" FontSize="9.5"
                                                                       VerticalAlignment="Center" Margin="0,1,4,0"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                            <TextBlock Text="{DynamicResource S.Picker.Private}" FontSize="11"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ExePath}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                           FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding SupportsPrivate}" Value="False">
                                            <Setter TargetName="PrivateBadge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <!-- 悬停：浅色高亮 + 强调色边框 + 显示手柄 -->
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="GripDots" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="MyEmptyText" Style="{StaticResource CardHint}" Visibility="Collapsed"
                                   Text="{DynamicResource S.Browsers.Empty}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Browsers.Detected}" />
                        <ItemsControl x:Name="DetectedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="10,6"
                                            Tag="{Binding}" ToolTip="{Binding ExePath}" Click="AddDetected_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="10"
                                                       Margin="10,1,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="DetectedEmptyText" Style="{StaticResource CardHint}" Visibility="Collapsed"
                                   Text="{DynamicResource S.Browsers.DetectedEmpty}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 页面：外观 ========== -->
                <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="32,16,32,28">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                    Content="{DynamicResource S.Appearance.Reset}" Click="ResetAppearance_Click" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Appearance.Title}" />
                                <TextBlock Style="{StaticResource CardHint}" Text="{DynamicResource S.Appearance.Hint}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Appearance.Popup}" />

                        <!-- 浏览器间距 -->
                        <Border Style="{StaticResource Panel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.Appearance.Spacing}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource S.Appearance.SpacingHint}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <Slider x:Name="SpacingSlider" Grid.Column="1" Style="{StaticResource SimpleSlider}"
                                        Minimum="0" Maximum="80" Value="30" ValueChanged="Appearance_Changed" />
                                <TextBlock x:Name="SpacingValue" Grid.Column="2" FontSize="12.5" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>

                        <!-- 图标大小 -->
                        <Border Style="{StaticResource Panel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.Appearance.IconSize}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource S.Appearance.IconSizeHint}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <Slider x:Name="IconSizeSlider" Grid.Column="1" Style="{StaticResource SimpleSlider}"
                                        Minimum="16" Maximum="40" Value="24" ValueChanged="Appearance_Changed" />
                                <TextBlock x:Name="IconSizeValue" Grid.Column="2" FontSize="12.5" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>

                        <!-- 无痕打开方式 -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Appearance.PrivateSection}" />
                        <Border Style="{StaticResource Panel}">
                            <DockPanel>
                                <ComboBox x:Name="PrivateTriggerBox" DockPanel.Dock="Right" Width="200" Style="{StaticResource SimpleCombo}"
                                          SelectionChanged="PrivateTrigger_Changed" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.Appearance.PrivateTrigger}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource S.Appearance.PrivateTriggerHint}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}">
                            <DockPanel>
                                <CheckBox x:Name="ShowPrivateToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" Click="ShowPrivate_Click" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.Appearance.ShowPrivateButton}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource S.Appearance.ShowPrivateButtonHint}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 语言 -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Appearance.LanguageSection}" />
                        <Border Style="{StaticResource Panel}">
                            <DockPanel>
                                <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="200" Style="{StaticResource SimpleCombo}"
                                          SelectionChanged="Language_Changed" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.Appearance.Language}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource S.Appearance.LanguageHint}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"
                                Click="Test_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="11"
                                           Margin="0,1,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource S.Home.Preview}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 页面：关于 ========== -->
                <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="32,16,32,28">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.About.Title}" />

                        <Border Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="2,16">
                            <DockPanel>
                                <Image Source="{StaticResource LogoImage}" Width="48" Height="48" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Brona" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="AboutVersionText" Style="{StaticResource CardHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.About.Location}" />
                        <Border Style="{StaticResource Panel}">
                            <TextBlock x:Name="ExePathText" FontSize="12" TextWrapping="Wrap" FlowDirection="LeftToRight"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.About.Uninstall}" />
                        <Border Style="{StaticResource Panel}">
                            <DockPanel>
                                <Button x:Name="UnregisterButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" Content="{DynamicResource S.About.Unregister}"
                                        Click="Unregister_Click" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.About.UninstallTitle}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource S.About.UninstallDesc}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
