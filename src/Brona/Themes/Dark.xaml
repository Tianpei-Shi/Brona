<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题配色 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#1B1C21" />
    <SolidColorBrush x:Key="CardBrush" Color="#25262D" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#373843" />
    <SolidColorBrush x:Key="PillBrush" Color="#1E1F25" />
    <SolidColorBrush x:Key="TileBrush" Color="#2D2F37" />
    <SolidColorBrush x:Key="InputBrush" Color="#1E1F25" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3F414C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#33343D" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F2F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A8B7" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#727786" />

    <SolidColorBrush x:Key="AccentBrush" Color="#7088FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#267088FF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#33353F" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1CFFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#3CCB85" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2B53A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B70" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5B5F6C" />

    <SolidColorBrush x:Key="ToggleOffBrush" Color="#3A3C47" />
    <SolidColorBrush x:Key="ToggleKnobOffBrush" Color="#A3A8B7" />
</ResourceDictionary>
