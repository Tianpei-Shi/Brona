<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题配色 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F4F8" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E6ED" />
    <SolidColorBrush x:Key="PillBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="TileBrush" Color="#F6F7FB" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D9DCE5" />
    <SolidColorBrush x:Key="DividerBrush" Color="#ECEEF3" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1D24" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#62677A" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9AA0AE" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4F6BF5" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#144F6BF5" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#EDEFF4" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#12000000" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#1FA463" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E8A317" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="MutedBrush" Color="#B4B9C6" />

    <SolidColorBrush x:Key="ToggleOffBrush" Color="#E3E6EE" />
    <SolidColorBrush x:Key="ToggleKnobOffBrush" Color="#8A90A0" />
</ResourceDictionary>
